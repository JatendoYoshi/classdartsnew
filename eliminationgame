<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Class Bracket</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Atkinson+Hyperlegible:wght@400;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#f3f5f8;--card:#fff;--ink:#14213d;--mute:#5b6678;--line:#14213d;--soft:#d5dbe5;--hi:#ffd23f;--hi-ink:#14213d;--btn:#14213d;--btn-ink:#fff;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1624;--card:#18223a;--ink:#eef1f7;--mute:#9aa6bd;--line:#c9d2e3;--soft:#2c3a5a;--btn:#ffd23f;--btn-ink:#14213d;color-scheme:dark}}
:root[data-theme="dark"]{--bg:#0f1624;--card:#18223a;--ink:#eef1f7;--mute:#9aa6bd;--line:#c9d2e3;--soft:#2c3a5a;--btn:#ffd23f;--btn-ink:#14213d;color-scheme:dark}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--ink);font-family:"Atkinson Hyperlegible",system-ui,-apple-system,"Segoe UI",sans-serif;font-size:16px;line-height:1.45}
main{max-width:1280px;margin:0 auto;padding:20px 16px 48px}
h1{font-size:1.6rem;margin:0 0 4px}
.sub{color:var(--mute);margin:0 0 16px}
.tabs{display:flex;gap:8px;margin-bottom:18px;border-bottom:2px solid var(--soft)}
.tab{background:none;border:0;color:var(--mute);font:inherit;font-weight:700;padding:10px 16px;cursor:pointer;border-bottom:4px solid transparent;margin-bottom:-2px}
.tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--hi)}
button,input,select,textarea{font:inherit;color:var(--ink)}
button:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,.box:focus-visible{outline:3px solid var(--hi);outline-offset:2px}
.btn{background:var(--btn);color:var(--btn-ink);border:0;border-radius:6px;padding:8px 14px;font-weight:700;cursor:pointer}
.btn.ghost{background:transparent;color:var(--ink);border:2px solid var(--soft)}
.btn.sm{padding:5px 10px}
.panel{background:var(--card);border:2px solid var(--soft);border-radius:8px;padding:14px;margin-bottom:16px}
.panel input[type=text],.panel select,.ov input,.ov select,.panel textarea{padding:7px 8px;border:2px solid var(--soft);border-radius:6px;background:var(--bg)}
.toolbar{display:flex;flex-wrap:wrap;gap:8px;align-items:center}
.toolbar label{color:var(--mute);font-size:.95rem}
.msg{color:var(--mute);min-height:1.4em;margin:8px 0 0;font-size:.95rem}
.fitwrap{overflow:hidden;width:100%}
#fit{position:relative;transform-origin:top left}
#fit svg{position:absolute;inset:0}
#fit path{fill:none;stroke:var(--line);stroke-width:2.5}
.box{position:absolute;border:2.5px solid var(--line);border-radius:3px;background:var(--card);display:flex;align-items:center;padding:0 10px;font-weight:700;white-space:nowrap;overflow:hidden;cursor:pointer}
.box:hover{background:var(--soft)}
.box span{overflow:hidden;text-overflow:ellipsis}
.box.empty{color:var(--mute);font-weight:400}
.box.won{background:var(--hi);color:var(--hi-ink);border-color:var(--hi-ink)}
.box.champ{justify-content:center;border-width:3px}
.vs{position:absolute;width:70px;text-align:center;font-weight:700;color:var(--mute)}
.ov{position:fixed;inset:0;background:rgba(10,15,30,.55);display:grid;place-items:center;padding:16px;z-index:50}
.dlg{background:var(--card);border:2px solid var(--line);border-radius:10px;width:100%;max-width:460px;max-height:90vh;overflow:auto;padding:18px}
.dlg h2{margin:0 0 12px;font-size:1.15rem}
.dlg .r{display:flex;gap:8px;margin-bottom:10px}
.dlg .r>*{flex:1;min-width:0}
.dlg .r .btn{flex:none}
.plist{display:flex;flex-wrap:wrap;gap:6px;max-height:200px;overflow:auto;margin-bottom:12px}
.chip{border:2px solid var(--soft);background:var(--bg);border-radius:20px;padding:4px 12px;cursor:pointer}
.chip:hover{border-color:var(--hi);background:var(--hi);color:var(--hi-ink)}
.chip:disabled{opacity:.45;cursor:not-allowed}
.foot{display:flex;justify-content:space-between;gap:8px}
.nl{display:grid;grid-template-columns:220px 1fr;gap:16px;align-items:start}
.side{display:flex;flex-direction:column;gap:4px}
.side button{display:flex;justify-content:space-between;gap:8px;text-align:left;background:none;border:2px solid transparent;border-radius:6px;padding:7px 10px;cursor:pointer}
.side button[aria-pressed="true"]{background:var(--hi);color:var(--hi-ink);font-weight:700}
.side .n{color:inherit;opacity:.7}
.side .add{display:flex;gap:6px;margin-top:10px}
.side .add input{min-width:0;flex:1}
.tbl{width:100%;border-collapse:collapse}
.tbl th{text-align:left;color:var(--mute);font-weight:400;padding:4px 6px}
.tbl td{padding:4px 6px;border-top:1px solid var(--soft)}
.tbl input,.tbl select{width:100%}
.hd{display:flex;gap:8px;align-items:center;margin-bottom:10px;flex-wrap:wrap}
.hd input{font-weight:700;font-size:1.1rem}
details summary{cursor:pointer;font-weight:700}
@media (max-width:760px){.nl{grid-template-columns:1fr}.side{flex-direction:row;flex-wrap:wrap}}
[hidden]{display:none!important}
</style>
</head>
<body>
<main>
<h1>Class bracket</h1>
<p class="sub">Click any box to choose a person. Add your students and teachers on the People tab.</p>
<div class="tabs" role="tablist">
  <button class="tab" role="tab" aria-selected="true" data-tab="bracket">Bracket</button>
  <button class="tab" role="tab" aria-selected="false" data-tab="people">People</button>
</div>

<section id="bracket">
  <div class="panel">
    <div class="toolbar">
      <label for="tbMode">Players</label>
      <select id="tbMode"><option value="8">8</option><option value="16">16</option></select>
      <label for="tbCls">Random fill from</label>
      <select id="tbCls"></select>
      <select id="tbRole" aria-label="Role"><option value="student">Students</option><option value="teacher">Teachers</option><option value="any">Everyone</option></select>
      <button class="btn" id="fillAll">Fill empty slots</button>
      <button class="btn ghost" id="resetWin">Reset winners</button>
      <button class="btn ghost" id="clearAll">Clear all</button>
    </div>
    <p class="msg" id="msg" role="status"></p>
  </div>
  <div class="fitwrap" id="wrap"><div id="fit"></div></div>
</section>

<section id="people" hidden>
  <div class="nl">
    <nav class="side panel" id="side" aria-label="People groups"></nav>
    <div id="pmain"></div>
  </div>
</section>
</main>
<datalist id="dl"></datalist>
<div id="modal" hidden></div>

<script>
(function(){
var KEY="classBracket.v3";
var S={mode:8,classes:[],people:[],slots:Array(16).fill(""),pick:{cls:"all",role:"student"},rd:null,champ:""};
function uid(){return "i"+Date.now().toString(36)+Math.random().toString(36).slice(2,7);}
function KK(){return S.mode===16?4:3;}
function initRd(){var K=KK();S.rd=[null];for(var k=1;k<K;k++)S.rd.push(Array(S.mode>>k).fill(""));S.champ="";}
function R(k){return k===0?S.slots:S.rd[k];}

/* load, with migration from earlier versions */
try{
  var raw=localStorage.getItem(KEY),o2=localStorage.getItem("classBracket.v2"),o1=localStorage.getItem("classBracket.v1");
  if(raw){var p=JSON.parse(raw);if(p&&p.people&&p.slots)S=p;}
  else if(o2){
    var q=JSON.parse(o2);
    if(q&&q.people){S.classes=q.classes||[];S.people=q.people;S.pick=q.pick||S.pick;
      (q.slots||[]).forEach(function(n,i){S.slots[i]=n;});
      initRd();(q.r2||[]).forEach(function(n,i){S.rd[1][i]=n;});(q.r3||[]).forEach(function(n,i){S.rd[2][i]=n;});S.champ=q.champ||"";}
  }else if(o1){
    var z=JSON.parse(o1);
    (z.groups||[]).forEach(function(g){
      var teach=g.name==="Teachers",cid="";
      if(!teach){cid=uid();S.classes.push({id:cid,name:g.name});}
      g.people.forEach(function(n){S.people.push({id:uid(),name:n,role:teach?"teacher":"student",cls:cid});});
    });
  }
}catch(e){}
while(S.slots.length<16)S.slots.push("");
if(S.mode!==8&&S.mode!==16)S.mode=8;
if(!S.rd||S.rd.length!==KK()||!S.rd[KK()-1]||S.rd[KK()-1].length!==2)initRd();

function save(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}
function esc(s){return String(s).replace(/&/g,"&amp;").replace(/</g,"&lt;").replace(/>/g,"&gt;").replace(/"/g,"&quot;");}
function $(id){return document.getElementById(id);}
function msg(t){$("msg").textContent=t||"";}
function clsName(id){for(var i=0;i<S.classes.length;i++)if(S.classes[i].id===id)return S.classes[i].name;return "No class";}
function pool(cls,role){return S.people.filter(function(p){
  var c=cls==="all"||(cls==="none"?p.cls==="":p.cls===cls);
  return c&&(role==="any"||p.role===role);});}
function clsOptions(){
  var h='<option value="all">All classes</option>';
  S.classes.forEach(function(c){h+='<option value="'+c.id+'">'+esc(c.name)+'</option>';});
  return h+'<option value="none">No class</option>';}
function roleLabel(r){return r==="teacher"?"Teachers":r==="student"?"Students":"Everyone";}
function refreshDl(){$("dl").innerHTML=S.people.map(function(p){return '<option value="'+esc(p.name)+'">';}).join("");}

/* tabs */
document.querySelectorAll(".tab").forEach(function(b){b.onclick=function(){
  var t=b.dataset.tab;
  document.querySelectorAll(".tab").forEach(function(x){x.setAttribute("aria-selected",x===b?"true":"false");});
  $("bracket").hidden=t!=="bracket";$("people").hidden=t!=="people";
  if(t==="bracket"){initToolbar();renderBracket();}else{renderSide();renderMain();}
};});

/* toolbar */
function initToolbar(){
  $("tbMode").value=String(S.mode);
  $("tbCls").innerHTML=clsOptions();
  $("tbCls").value=S.pick.cls;if($("tbCls").value!==S.pick.cls)$("tbCls").value="all";
  $("tbRole").value=S.pick.role;
}
$("tbMode").onchange=function(){S.mode=+this.value;initRd();save();msg("");renderBracket();};
$("tbCls").onchange=function(){S.pick.cls=this.value;save();};
$("tbRole").onchange=function(){S.pick.role=this.value;save();};
function randomFrom(cls,role,exclude){
  var pl=pool(cls,role).map(function(p){return p.name;});
  var fresh=pl.filter(function(n){return exclude.indexOf(n)<0;});
  var src=fresh.length?fresh:pl;
  return {name:src.length?src[Math.floor(Math.random()*src.length)]:"",repeat:pl.length>0&&!fresh.length};
}
$("fillAll").onclick=function(){
  var used=S.slots.slice(0,S.mode).filter(Boolean),rep=false,miss=false;
  for(var i=0;i<S.mode;i++){
    if(S.slots[i])continue;
    var r=randomFrom(S.pick.cls,S.pick.role,used);
    if(!r.name){miss=true;break;}
    if(r.repeat)rep=true;
    S.slots[i]=r.name;used.push(r.name);
  }
  initRd();save();renderBracket();
  msg(miss?"Not enough people in that group. Add more on the People tab.":rep?"Some names repeat because the group has fewer than "+S.mode+" people.":"");
};
$("resetWin").onclick=function(){initRd();save();renderBracket();};
$("clearAll").onclick=function(){S.slots=Array(16).fill("");initRd();save();renderBracket();msg("");};

/* bracket drawing */
var G={W:1190,H:420};
function conn(x1,y1,x2,y2){var m=(x1+x2)/2;return '<path d="M'+x1+' '+y1+' H'+m+' V'+y2+' H'+x2+'"/>';}
function box(k,i,x,y,w,h,txt,ph,won,cls){
  return '<div class="box '+(txt?"":"empty")+(won?" won":"")+(cls?" "+cls:"")+'" data-k="'+k+'" data-i="'+i+'" tabindex="0" role="button" style="left:'+x+'px;top:'+(y-h/2)+'px;width:'+w+'px;height:'+h+'px"><span>'+esc(txt||ph)+'</span></div>';
}
function renderBracket(){
  var N=S.mode,K=KK(),n=N/2,sp=N===8?90:50,bh=N===8?38:32,cw=160,gap=40,cg=70;
  var W=2*(K*cw+(K-1)*gap)+cg,H=40+sp*n+20;G.W=W;G.H=H;
  var ys=[],k,m,s;
  ys[0]=[];for(m=0;m<n;m++)ys[0].push(40+sp*m+sp/2);
  for(k=1;k<K;k++){ys[k]=[];for(m=0;m<(n>>k);m++)ys[k].push((ys[k-1][2*m]+ys[k-1][2*m+1])/2);}
  var xL=function(kk){return kk*(cw+gap);};
  var b="",p="";
  for(s=0;s<2;s++){
    for(k=0;k<K;k++){
      var cnt=n>>k;
      for(m=0;m<cnt;m++){
        var gi=s*cnt+m,name=R(k)[gi];
        var x=s?W-(xL(k)+cw):xL(k);
        var won=name&&(k<K-1?R(k+1)[gi>>1]===name:S.champ===name);
        b+=box(k,gi,x,ys[k][m],cw,bh,name,k===0?"Click to choose":k===K-1?"Finalist":"Winner",won);
        if(k<K-1){
          var ox=s?x:x+cw,ix=s?W-(xL(k+1)+cw)+cw:xL(k+1);
          p+=conn(ox,ys[k][m],ix,ys[k+1][m>>1]);
        }
      }
    }
  }
  var fy=ys[K-1][0];
  b+='<div class="vs" style="left:'+(W/2-35)+'px;top:'+(fy-12)+'px">vs</div>';
  b+=box("c",0,W/2-100,28,200,44,S.champ,"Champion",!!S.champ,"champ");
  var f=$("fit");f.style.width=W+"px";f.style.height=H+"px";
  f.innerHTML='<svg width="'+W+'" height="'+H+'" viewBox="0 0 '+W+' '+H+'" aria-hidden="true">'+p+'</svg>'+b;
  f.querySelectorAll(".box").forEach(function(el){
    el.onclick=function(){openBox(el.dataset.k,+el.dataset.i);};
    el.onkeydown=function(e){if(e.key==="Enter"||e.key===" "){e.preventDefault();openBox(el.dataset.k,+el.dataset.i);}};
  });
  fit();
}
function fit(){
  var w=$("wrap").clientWidth,sc=Math.min(1,w/G.W);
  $("fit").style.transform="scale("+sc+")";$("wrap").style.height=(G.H*sc)+"px";
}
window.addEventListener("resize",fit);

/* modals */
function closeModal(){$("modal").hidden=true;$("modal").innerHTML="";}
function showModal(html){
  $("modal").innerHTML='<div class="ov" id="ov"><div class="dlg" role="dialog" aria-modal="true">'+html+'</div></div>';
  $("modal").hidden=false;
  $("ov").onclick=function(e){if(e.target===$("ov"))closeModal();};
}
document.addEventListener("keydown",function(e){if(e.key==="Escape"&&!$("modal").hidden)closeModal();});

function openBox(k,i){
  var K=KK();
  if(k==="0"||k===0)return openSlot(i);
  var feeders,t;
  if(k==="c"){feeders=[R(K-1)[0],R(K-1)[1]];t="Who wins the final?";}
  else{k=+k;feeders=[R(k-1)[2*i],R(k-1)[2*i+1]];t=k===K-1?"Who goes to the final?":"Who wins this match?";}
  var h='<h2>'+t+'</h2><div class="plist">';
  feeders.forEach(function(n,j){h+='<button class="chip" data-w="'+j+'"'+(n?"":" disabled")+'>'+esc(n||"Waiting for earlier round")+'</button>';});
  h+='</div><div class="foot"><button class="btn ghost" id="mClear">Clear winner</button><button class="btn" id="mClose">Close</button></div>';
  showModal(h);
  $("modal").querySelectorAll("[data-w]").forEach(function(el){el.onclick=function(){setWinner(k,i,feeders[+el.dataset.w]);closeModal();};});
  $("mClear").onclick=function(){setWinner(k,i,"");closeModal();};
  $("mClose").onclick=closeModal;
}
function setWinner(k,i,n){
  var K=KK();
  if(k==="c")S.champ=n;
  else{S.rd[k][i]=n;for(var kk=k+1;kk<K;kk++)S.rd[kk][i>>(kk-k)]="";S.champ="";}
  save();renderBracket();
}
function openSlot(i){
  var h='<h2>Slot '+(i+1)+' of '+S.mode+'</h2>'+
  '<div class="r"><input type="text" id="mName" list="dl" placeholder="Type a name" aria-label="Type a name" value="'+esc(S.slots[i])+'"><button class="btn" id="mUse">Use name</button></div>'+
  '<div class="r"><select id="mCls" aria-label="Class">'+clsOptions()+'</select><select id="mRole" aria-label="Role"><option value="student">Students</option><option value="teacher">Teachers</option><option value="any">Everyone</option></select></div>'+
  '<div class="r"><button class="btn" id="mRand">Pick at random</button></div><p class="msg" id="mMsg"></p>'+
  '<div class="plist" id="mList"></div>'+
  '<div class="foot"><button class="btn ghost" id="mClear">Clear slot</button><button class="btn" id="mClose">Close</button></div>';
  showModal(h);
  $("mCls").value=S.pick.cls;if($("mCls").value!==S.pick.cls)$("mCls").value="all";
  $("mRole").value=S.pick.role;
  function others(){return S.slots.slice(0,S.mode).filter(function(s,j){return j!==i&&s;});}
  function put(n){S.slots[i]=n;initRd();save();renderBracket();closeModal();}
  function list(){
    S.pick.cls=$("mCls").value;S.pick.role=$("mRole").value;save();
    var pl=pool(S.pick.cls,S.pick.role),used=others();
    $("mList").innerHTML=pl.length?pl.map(function(q){
      return '<button class="chip" data-n="'+esc(q.name)+'"'+(used.indexOf(q.name)>=0?' disabled title="Already in a slot"':"")+'>'+esc(q.name)+'</button>';}).join(""):'<span class="msg">No '+roleLabel(S.pick.role).toLowerCase()+' here yet. Add some on the People tab.</span>';
    $("mList").querySelectorAll("[data-n]").forEach(function(el){el.onclick=function(){put(el.dataset.n);};});
  }
  $("mCls").onchange=list;$("mRole").onchange=list;list();
  $("mUse").onclick=function(){var v=$("mName").value.trim();if(v)put(v);};
  $("mName").onkeydown=function(e){if(e.key==="Enter")$("mUse").click();};
  $("mRand").onclick=function(){
    var r=randomFrom($("mCls").value,$("mRole").value,others());
    if(!r.name){$("mMsg").textContent="Nobody to pick from. Add people on the People tab.";return;}
    put(r.name);
  };
  $("mClear").onclick=function(){put("");};
  $("mClose").onclick=closeModal;
  $("mName").focus();
}

/* people tab */
var V="all",Q="";
function viewPeople(){
  return S.people.filter(function(p){
    var ok=V==="all"||(V==="teachers"?p.role==="teacher":V==="none"?p.cls==="":p.cls===V);
    return ok&&(!Q||p.name.toLowerCase().indexOf(Q.toLowerCase())>=0);
  }).sort(function(a,b){return a.name.localeCompare(b.name);});
}
function renderSide(){
  var cnt=function(f){return S.people.filter(f).length;};
  var items=[["all","Everyone",S.people.length],["teachers","Teachers",cnt(function(p){return p.role==="teacher";})]];
  S.classes.forEach(function(c){items.push([c.id,c.name,cnt(function(p){return p.cls===c.id;})]);});
  items.push(["none","No class",cnt(function(p){return p.cls==="";})]);
  var h="";
  items.forEach(function(it){h+='<button data-v="'+it[0]+'" aria-pressed="'+(V===it[0])+'"><span>'+esc(it[1])+'</span><span class="n">'+it[2]+'</span></button>';});
  h+='<div class="add"><input type="text" id="newCls" placeholder="New class" aria-label="New class name"><button class="btn sm" id="addCls">Add</button></div>';
  $("side").innerHTML=h;
  $("side").querySelectorAll("[data-v]").forEach(function(el){el.onclick=function(){V=el.dataset.v;Q="";renderSide();renderMain();};});
  $("addCls").onclick=function(){var v=$("newCls").value.trim();if(!v)return;var id=uid();S.classes.push({id:id,name:v});V=id;save();renderSide();renderMain();};
  $("newCls").onkeydown=function(e){if(e.key==="Enter")$("addCls").click();};
}
function roleSel(v,attr){return '<select '+attr+' aria-label="Role"><option value="student"'+(v==="student"?" selected":"")+'>Student</option><option value="teacher"'+(v==="teacher"?" selected":"")+'>Teacher</option></select>';}
function clsSel(v,attr){var h='<select '+attr+' aria-label="Class"><option value="">No class</option>';S.classes.forEach(function(c){h+='<option value="'+c.id+'"'+(v===c.id?" selected":"")+'>'+esc(c.name)+'</option>';});return h+'</select>';}
function renderMain(){
  var isCls=S.classes.some(function(c){return c.id===V;});
  var defRole=V==="teachers"?"teacher":"student",defCls=isCls?V:"";
  var h='<div class="panel">';
  if(isCls)h+='<div class="hd"><input type="text" id="clsName" value="'+esc(clsName(V))+'" aria-label="Class name"><button class="btn ghost sm" id="delCls">Delete class</button></div>';
  else h+='<div class="hd"><strong>'+(V==="all"?"Everyone":V==="teachers"?"Teachers":"No class")+'</strong></div>';
  h+='<div class="toolbar"><input type="text" id="aName" placeholder="Full name" aria-label="Full name">'+roleSel(defRole,'id="aRole"')+clsSel(defCls,'id="aCls"')+'<button class="btn" id="aBtn">Add person</button></div>'+
  '<p class="msg" id="pMsg" role="status"></p></div>'+
  '<div class="panel"><div class="toolbar" style="margin-bottom:8px"><input type="text" id="search" placeholder="Search names" aria-label="Search names"><span class="msg" id="cnt" style="margin:0"></span></div>'+
  '<table class="tbl"><thead><tr><th>Name</th><th>Role</th><th>Class</th><th></th></tr></thead><tbody id="rows"></tbody></table></div>'+
  '<div class="panel"><details><summary>Paste a list</summary><p class="msg">One name per line. Everyone is added with the role and class you choose here.</p>'+
  '<textarea id="bulk" rows="6" style="width:100%" aria-label="Names to import"></textarea><div class="toolbar" style="margin-top:8px">'+roleSel(defRole,'id="bRole"')+clsSel(defCls,'id="bCls"')+'<button class="btn" id="bBtn">Import names</button></div></details></div>';
  $("pmain").innerHTML=h;
  $("search").value=Q;
  $("search").oninput=function(){Q=this.value;renderRows();};
  if(isCls){
    $("clsName").oninput=function(){S.classes.forEach(function(c){if(c.id===V)c.name=$("clsName").value;});save();};
    $("clsName").onchange=renderSide;
    $("delCls").onclick=function(){
      if(!confirm("Delete “"+clsName(V)+"”? Its people stay on the list with no class."))return;
      S.people.forEach(function(p){if(p.cls===V)p.cls="";});
      S.classes=S.classes.filter(function(c){return c.id!==V;});V="all";save();renderSide();renderMain();};
  }
  function add(){
    var nm=$("aName").value.trim();if(!nm)return;
    var role=$("aRole").value,cls=$("aCls").value;
    if(S.people.some(function(p){return p.name.toLowerCase()===nm.toLowerCase()&&p.cls===cls&&p.role===role;})){$("pMsg").textContent=nm+" is already in that list.";return;}
    S.people.push({id:uid(),name:nm,role:role,cls:cls});save();$("aName").value="";$("pMsg").textContent="Added "+nm+".";renderSide();renderRows();$("aName").focus();
  }
  $("aBtn").onclick=add;$("aName").onkeydown=function(e){if(e.key==="Enter")add();};
  $("bBtn").onclick=function(){
    var role=$("bRole").value,cls=$("bCls").value,c=0;
    $("bulk").value.split("\n").forEach(function(l){
      l=l.trim();if(!l)return;
      if(S.people.some(function(p){return p.name.toLowerCase()===l.toLowerCase()&&p.cls===cls&&p.role===role;}))return;
      S.people.push({id:uid(),name:l,role:role,cls:cls});c++;});
    $("bulk").value="";save();$("pMsg").textContent="Imported "+c+" "+(c===1?"person":"people")+".";renderSide();renderRows();};
  renderRows();
}
function renderRows(){
  var list=viewPeople();
  $("cnt").textContent=list.length+(list.length===1?" person":" people");
  $("rows").innerHTML=list.length?list.map(function(p){
    return '<tr data-id="'+p.id+'"><td><input type="text" data-f="name" value="'+esc(p.name)+'" aria-label="Name"></td><td>'+roleSel(p.role,'data-f="role"')+'</td><td>'+clsSel(p.cls,'data-f="cls"')+'</td><td><button class="btn ghost sm" data-d="1" aria-label="Remove '+esc(p.name)+'">Remove</button></td></tr>';
  }).join(""):'<tr><td colspan="4" class="msg">Nobody here yet. Add a person above.</td></tr>';
  $("rows").querySelectorAll("tr[data-id]").forEach(function(tr){
    var p=S.people.filter(function(x){return x.id===tr.dataset.id;})[0];
    tr.querySelector('[data-f="name"]').oninput=function(){p.name=this.value;save();};
    tr.querySelector('[data-f="role"]').onchange=function(){p.role=this.value;save();renderSide();renderRows();};
    tr.querySelector('[data-f="cls"]').onchange=function(){p.cls=this.value;save();renderSide();renderRows();};
    tr.querySelector("[data-d]").onclick=function(){S.people=S.people.filter(function(x){return x!==p;});save();renderSide();renderRows();};
  });
  refreshDl();
}

refreshDl();initToolbar();renderBracket();
})();
</script>
</body>
</html>
